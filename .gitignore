# ==== zzwork 仓库：只跟踪源码与文档 ====
# 忽略其余内容，白名单放行需要的目录

/*
!/.gitignore
!/README.md
!/docs/
!/app/
!/.github/

# Electron 应用：忽略依赖与构建产物
/app/node_modules/
/app/out/
/app/release/
/app/test/.tmp/

# 临时与本地文件
*.log
*.png
.DS_Store
Thumbs.db

# 打包图标需要入库（覆盖上面的 *.png 忽略）
!/app/build/
!/app/build/icon.png
!/app/build/icon.ico
!/app/build/icon.svg
